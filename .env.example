# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for $5.99/mo — create with: npm run stripe:setup
STRIPE_PRICE_ID=price_...

# Public app URL (no trailing slash). Use localhost or your tunnel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for signing the httpOnly session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional — TDOT SmartWay public API key (also embedded in smartway.tn.gov config).
# Server-only; fallback built into tennessee adapter if unset.
# TDOT_API_KEY=8d3b7a82635d476795c09b2c41facc60
